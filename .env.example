# Copy to .env for local runs. In GitHub, set these as Actions secrets/variables. NEVER commit real values.
GITHUB_TOKEN=
ANTHROPIC_API_KEY=            # optional; without it scripts are template-generated (zero LLM cost)
LLM_MODEL=claude-haiku-4-5-20251001
DAILY_AI_BUDGET_USD=1.00
MAX_LLM_CALLS_PER_DAY=100
MAX_VIDEOS_PER_DAY=4
DAILY_GITHUB_VIDEOS=2         # daily mix: 2 GitHub + 1 AI-tools + 1 websites video
DAILY_NEWS_VIDEOS=0             # AI news off; replaced by the websites series
DAILY_SITES_VIDEOS=1
SITES_PER_VIDEO=5
DAILY_TOOLS_VIDEOS=1           # "N AI tools for <category>" videos
TOOLS_PER_VIDEO=10
MAX_VIDEOS_PER_RUN=1
GENERATE_SCORE_NEWS=65
MAX_RENDERS_PER_TOPIC=2
MIN_TOPIC_SCORE=65
GENERATE_SCORE=75
PRIORITY_SCORE=90
DB_PATH=data/pipeline.db
OUT_DIR=out
VOICE_SPEED=1.2               # narration speed multiplier (1.0 = natural)
VOICE_STYLE_REF=style_reference.wav  # clip in VOICE_REF_REPO whose speaking style the cloned voice copies
VOICE_STYLE_BETA=0.0          # 0 = copy that style exactly, 1 = ignore it
VOICE_EXPRESSIVENESS=1.5      # StyleTTS2 embedding_scale; higher = more emotional
# Publishing (official APIs only). Missing credentials => job marked WAITING_FOR_API.
YOUTUBE_ACCESS_TOKEN=
ZERNIO_API_KEY=              # optional: posts to Facebook/Instagram + keyword->DM automations
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=       # long-lived Page token (pages_manage_posts, instagram_content_publish)
META_IG_USER_ID=
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_... (server-side only)
